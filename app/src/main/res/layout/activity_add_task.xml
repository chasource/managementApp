<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C2E0F9"
    android:padding="24dp"
    tools:context="AddTaskActivity">

    <!--Judul Halaman-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvFormTitle"
        android:text="Tambah Tugas Baru"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

   <!--Input Mata Pelajaran-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/labelMapel"
        android:text="Mata Pelajaran"
        android:textSize="14sp"
        android:textColor="#636E72"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvFormTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Contoh Pemrograman Berorientasi Objek"
        android:id="@+id/editMapel"
        android:textSize="14sp"
        android:inputType="text"
        android:background="@color/white"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/labelMapel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--input judul tugas-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/labelTugas"
        android:text="Judul Tugas"
        android:textSize="14sp"
        android:textColor="#636E72"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/editMapel"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/editJudulTugas"
        android:hint="Contoh: Membuat Aplikasi CRUD Android"
        android:textSize="14sp"
        android:inputType="text"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/labelTugas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--Input Keterangan / Deskripsi-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/labelDeskripsi"
        android:text="Catatan / Deskripsi"
        android:textSize="14sp"
        android:textColor="#636E72"
        app:layout_constraintTop_toBottomOf="@id/editJudulTugas"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <EditText
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:id="@+id/editDeskripsi"
        android:gravity="top|start"
        android:hint="Tuliskan detail instruksi disini..."
        android:textSize="14sp"
        android:inputType="textMultiLine"
        android:background="#FFFFFF"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/labelDeskripsi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!--Tombol simpan-->
    <Button
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/tombolSave"
        android:text="Simpan Tugas"
        android:backgroundTint="#008894"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/editDeskripsi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>




</androidx.constraintlayout.widget.ConstraintLayout>